# ─── EDUKRO – konfiguracja serwera ───────────────────────────────────────────
# Ten plik jest kopiowany do .env przy pierwszym uruchomieniu. .env NIE trafia do repozytorium.

EDUKRO_ENV=development          # development | production
PORT=3000
HOST=127.0.0.1                  # 0.0.0.0 = dostęp z innych urządzeń w sieci szkolnej

# Kody początkowe – używane TYLKO przy pierwszym utworzeniu bazy (zapisywane jako hasz).
# Po pierwszym uruchomieniu zmień je w aplikacji i usuń z tego pliku.
EDUKRO_INIT_TEACHER_CODE=1111   # Joanna Hyżorek
EDUKRO_INIT_ADMIN_CODE=0907     # administrator
# Wymuszenie zmiany kodu przy pierwszym logowaniu (domyślnie: tak w trybie production)
# FORCE_INITIAL_CODE_CHANGE=true

# Długość kodu (PIN) uczniów, nauczycieli i administratora: 4–8 cyfr.
PIN_LENGTH=4

# ─── Poczta (SMTP) ───────────────────────────────────────────────────────────
# Rejestracja uczniów nie wysyła e-maili (konta zatwierdza administrator) – te ustawienia są opcjonalne.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true dla portu 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                      # np. edukro@szkola.pl

# Tryb deweloperski poczty (tylko gdy SMTP nie jest ustawione i EDUKRO_ENV=development):
# wiadomości NIE są wysyłane – treść pojawia się w konsoli serwera i w data/dev-outbox.log.
EDUKRO_DEV_MAIL=1

# ─── Wygląd ──────────────────────────────────────────────────────────────────
SCHOOL_PHOTO=assets/szkola.jpg  # podmień plik public/assets/szkola.jpg na zdjęcie szkoły
SCHOOL_PHOTO_FOCUS=50% 45%      # który fragment zdjęcia ma być zawsze widoczny (x y)
